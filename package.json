  "bugs": { "url": "https://github.com/eynalliomer/vidbucks/issues" },
  "bin": { "vidbucks": "bin/vidbucks.mjs" },
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": { "setup": "node scripts/setup.mjs", "status": "node scripts/status.mjs", "doctor": "node core/tools/doctor.mjs", "smoke": "node core/tools/smoke.mjs" },
  "keywords": ["claude-code", "agent-skills", "remotion", "video", "motion-graphics", "tts", "ai-agents"],
